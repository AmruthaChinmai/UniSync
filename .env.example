# Database URL:
# For local SQLite (works out of the box):
DATABASE_URL=sqlite:///./unisync.db

# For MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/unisync

# Gemini API Key (optional - if omitted, UniSync runs on its built-in heuristic agent engine):
GEMINI_API_KEY=

# Flask Configuration:
FLASK_ENV=development
SECRET_KEY=unisync-super-secret-key-2026
PORT=5000
